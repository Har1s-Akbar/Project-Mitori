FROM grafana/k6:latest AS k6_source

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    linux-perf \
    valgrind \
    curl \
    iproute2 \
    procps \
    pkg-config \
    gfortran \
    libopenblas-dev \
    liblapack-dev \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY --from=k6_source /usr/bin/k6 /usr/local/bin/k6

RUN pip install --no-cache-dir --upgrade pip setuptools wheel meson-python cython

RUN pip install --no-cache-dir \
    requests>=2.32.3 \
    redis==8.0.1 \
    PyJWT==2.13.0 \
    orjson==3.11.9 \
    "numpy>=2.1.0" \
    "pandas>=2.2.3" \
    "scipy>=1.14.0"

CMD ["bash"]